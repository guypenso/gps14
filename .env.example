# No secrets belong in Git. Set these privately in Render Environment.
APP_ENV=production
ENABLE_RENTCAST=false
ENABLE_EMAIL=false
RENTCAST_API_KEY=
RESEND_API_KEY=
DATABASE_URL=
EMAIL_FROM=
EMAIL_TO=
CITY_BOUNDARY_FILE=data/pittsburgh.geojson
# A new approval ID represents a new explicit user-approved allowance.
# Increasing this count also requires approval. one_time never resets automatically.
API_APPROVAL_MODE=one_time
API_APPROVAL_ID=
APPROVED_API_REQUESTS=0
MAX_API_REQUESTS_PER_RUN=4
MAX_API_REQUESTS_PER_DAY=4
MAX_API_REQUESTS_PER_MONTH=40
BILLING_DAY=1
# Opt-in billing_cycle mode requires an actual provider cycle start and prior usage.
# Leave disabled until a recurring allowance is explicitly approved.
BILLING_CYCLE_ANCHOR=
BILLING_USAGE_BASELINE=-1
LISTING_REQUESTS_PER_DAY=1
NEGATIVE_TAX_CACHE_HOURS=6
# Email needs ENABLE_EMAIL=true, configured Resend and separate explicit approval.
EMAIL_APPROVAL_ID=
LISTING_LIMIT=500
MAX_LISTING_PAGES=20
TAX_CACHE_HOURS=168
LISTING_CACHE_MINUTES=15
HTTP_TIMEOUT_SECONDS=30
NETWORK_RETRIES=0
# Dashboard uses a separate strong secret; Render generates one automatically.
DASHBOARD_USERNAME=owner
DASHBOARD_PASSWORD=

# RealScout: dormant until permitted use, controlled forwarding, and deployment approved.
# Keep DISCOVERY_SOURCE=rentcast while staging; switch the EXISTING cron, never add one.
DISCOVERY_SOURCE=rentcast
ENABLE_REALSCOUT_INGEST=false
ENABLE_REALSCOUT_WORKER=false
ENABLE_REALSCOUT_DAILY=false
ENABLE_REALSCOUT_ENRICHMENT=false
ENABLE_REALSCOUT_STATUS_VERIFICATION=false
REALSCOUT_PROCESSING_APPROVAL_ID=
# One dedicated inbox per template, exact original From address, no wildcards.
REALSCOUT_INBOX_PROFILES=[]
REALSCOUT_SAVED_SEARCH_VALIDATED=false
# Exact provider raw-message storage hosts; populate privately after one approved receipt.
REALSCOUT_RAW_DOWNLOAD_HOSTS=[]
# RETIRED header-trust escape hatches: keep empty; nonempty now fails closed.
REALSCOUT_TRUSTED_AUTHSERV_ID=
REALSCOUT_AUTH_CONTRACT_APPROVAL_ID=
RESEND_WEBHOOK_SECRET=
RESEND_RECEIVING_API_KEY=
# Fernet key; keep backup separately from DB. Loss makes private listing links unreadable.
REALSCOUT_LINK_KEY=
PUBLIC_APP_URL=
REALSCOUT_WORKER_MAX_JOBS=20
REALSCOUT_WORKER_MAX_ATTEMPTS=5
REALSCOUT_WORKER_LEASE_SECONDS=180
REALSCOUT_WORKER_POLL_SECONDS=30

# Multi-source discovery: dormant until licensed access and explicit activation approval.
ENABLE_UNIFIED_DISCOVERY=false
ENABLE_UNIFIED_DAILY=false
ENABLE_MLS_EXPORT_WEBHOOK=false
ENABLE_UNIFIED_RENTCAST_DISCOVERY=false
ENABLE_UNIFIED_RENTCAST_ENRICHMENT=false
ENABLE_UNIFIED_STATUS_VERIFICATION=false
ENABLE_UNIFIED_RENT_ESTIMATES=false
UNIFIED_PROCESSING_APPROVAL_ID=
UNIFIED_SOURCES_JSON=[]
UNIFIED_ASSUMPTIONS_JSON={}
UNIFIED_FINANCING_MODE=
UNIFIED_RENTCAST_INTERVAL_DAYS=7
UNIFIED_MAX_ENRICHMENT_CANDIDATES=3
UNIFIED_MLS_REVERIFY_LIMIT=3
RENTCAST_DISCOVERY_CAP=8
RENTCAST_ENRICHMENT_CAP=22
RENTCAST_VERIFICATION_RESERVE=10
# Scoped MLS credentials and CSV signing secrets belong only in Render secrets.
# Keep existing DISCOVERY_SOURCE unchanged until approved cutover.

# Listing-only MVP is the default. Advanced analysis requires explicit opt-in.
# Existing ENABLE_UNIFIED_* and provider flags above remain false.
UNIFIED_REPORT_MODE=mvp
ENABLE_DUAL_UNDERWRITING=false
UNIFIED_FINANCING_SCENARIOS_JSON={}
UNIFIED_PROPERTY_INPUTS_JSON={}
UNIFIED_PROPERTY_FINANCING_JSON={}
UNIFIED_PRIMARY_FINANCING_SCENARIO=base
UNIFIED_RANKING_WEIGHTS_JSON={"annual_return":0.5,"monthly_cash_flow":0.5}
UNIFIED_RANKING_APPROVAL_ID=
# No loan terms, insurance, renovation or operating assumptions are auto-approved.
